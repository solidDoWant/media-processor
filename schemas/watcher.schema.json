{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/solidDoWant/media-processor/internal/watcherconfig/config",
  "$ref": "#/$defs/Config",
  "$defs": {
    "Config": {
      "properties": {
        "cron_schedule": {
          "type": "string",
          "pattern": "^(\\S+ ){5}\\S+$"
        },
        "watches": {
          "items": {
            "$ref": "#/$defs/WatchEntry"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "watches"
      ]
    },
    "WatchEntry": {
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "string",
          "enum": [
            "MovieWorkflow",
            "ShowWorkflow"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "path",
        "workflow"
      ]
    }
  }
}
