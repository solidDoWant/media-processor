{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/solidDoWant/media-processor/internal/watcherconfig/config",
  "$ref": "#/$defs/Config",
  "$defs": {
    "CompiledRegexp": {
      "type": "string",
      "format": "regex"
    },
    "Config": {
      "properties": {
        "cronSchedule": {
          "$ref": "#/$defs/CronExpression"
        },
        "watches": {
          "items": {
            "$ref": "#/$defs/WatchEntry"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CronExpression": {
      "type": "string",
      "pattern": "^(\\S+ ){5}\\S+$"
    },
    "MediaType": {
      "type": "string",
      "enum": [
        "movie",
        "show"
      ]
    },
    "WatchEntry": {
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "$ref": "#/$defs/MediaType"
        },
        "ignorePatterns": {
          "items": {
            "$ref": "#/$defs/CompiledRegexp"
          },
          "type": "array"
        },
        "preserveSource": {
          "type": "boolean"
        },
        "retainEmptyDirectories": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "path",
        "mediaType"
      ]
    }
  }
}
