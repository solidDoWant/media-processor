{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Managers: gomod (go.mod), nix (flake.lock), helmv3 (the chart's
  // dependencies) and docker-compose (the local and e2e stacks).
  // Policy is split by topic under .github/renovate/.
  extends: [
    "config:recommended",
    ":semanticCommits",
    ":timezone(America/Chicago)",
    // Applied in this order, then the packageRules below. local> presets are
    // read from the default branch.
    "local>solidDoWant/media-processor//.github/renovate/safety.json5",
    "local>solidDoWant/media-processor//.github/renovate/groups.json5",
    "local>solidDoWant/media-processor//.github/renovate/labels.json5",
  ],

  // Hold new releases briefly (supply-chain safety, chained hotfix releases).
  // timestamp-optional: registries without release timestamps would be held forever.
  minimumReleaseAge: "3 days",
  // cspell:words Behaviour
  minimumReleaseAgeBehaviour: "timestamp-optional",
  // Expected outcome of the above; keep it out of the repository-problems list.
  logLevelRemap: [
    {
      matchMessage: "/did not have a releaseTimestamp, but as we're running with minimumReleaseAgeBehaviour=timestamp-optional/",
      newLogLevel: "debug",
    },
  ],
  suppressNotifications: ["prEditedNotification", "prIgnoreNotification"],
  // Tags can be re-pushed; a digest pins the exact content.
  pinDigests: true,

  // Replaces config:recommended's list, so the defaults are repeated.
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    ".claude/**",
    "**/docs/**",
    "**/testdata/**",
  ],

  // The e2e stack's own images, built locally by the Makefile (watcher:latest,
  // worker:latest). Looked up as-is they'd resolve to unrelated Docker Hub images.
  ignoreDeps: ["watcher", "worker"],

  // Off by default upstream. Locked flake inputs only move through
  // lockFileMaintenance (`nix flake update`).
  nix: { enabled: true, lockFileMaintenance: { enabled: true } },
  // Opens only when ticked on the Dependency Dashboard, not every week.
  lockFileMaintenance: { dependencyDashboardApproval: true },

  postUpdateOptions: ["gomodTidy"],

  packageRules: [
    // Last so it overrides any preset rule. The owner merges Renovate's PRs.
    {
      description: "Automerge disabled for everything",
      matchPackageNames: ["*"],
      automerge: false,
    },
  ],
}
